# AI-DLC guardrails — shipped defaults. Do NOT edit here to customise:
# create <project>/.aidlc/guardrails.env with the same keys to override per project.
# (/aidlc-init can generate that file from the guardrails: block in aidlc.config.yaml.)
# modes: block | warn | off
GUARDRAILS_ENABLED=true

# Governance mode (ENH-002): advisory | enforced
#   advisory  — per-gate modes below apply; GUARDRAILS_ENABLED=false disables gates.
#   enforced  — PROTECTED gates (publish gate, secret scan) are forced to block and
#               CANNOT be silently downgraded by a per-gate mode or GUARDRAILS_ENABLED;
#               approvals are action-bound (APPROVAL_BINDING forced true).
GOVERNANCE_MODE=advisory

# Action-bound approvals (ENH-001): bind each approval to one operation
# (backend + target + payload digest when a manifest is recorded via propose.sh;
# target/backend hints otherwise), single-use + expiring. Forced true when enforced.
# Left false by default so existing advisory setups keep their current behaviour.
# Note: under GOVERNANCE_MODE=enforced a manifest-bound approval (recorded via
# propose.sh) is MANDATORY — a bare "yes" or prompt-hint approval will NOT authorise
# a write; malformed input to a protected gate fails closed; and an extended set of
# Bash write forms (glab api / gh / git push / curl-to-tracker) is gated.
APPROVAL_BINDING=false

# HP-2 Publish gate on tracker writes
PUBLISH_GATE_MODE=block
PUBLISH_GATE_TTL=600          # seconds an approval stays valid (covers a batch transfer)
PUBLISH_GATE_SINGLE_USE=false # true = one approval unlocks one write
PUBLISH_GATE_INCLUDE_BASH=true # also gate glab/acli/jira writes tunnelled through Bash

# HP-3 EARS validation before an AC-catalogue publish
EARS_MODE=warn

# HP-4 Secret scan on write/Bash tool arguments
SECRET_SCAN_MODE=block

# HP-5 Transfer sentinel (leaf completeness) — off by default
SENTINEL_ENABLED=false
SENTINEL_MODE=warn

# QMetry360 event emission (ENH-013) — optional. off | local | live
#   local (default) records events to .aidlc/guardrails/qmetry-events.jsonl.
#   live additionally POSTs to QMETRY_API_URL with the token in $QMETRY_TOKEN_ENV —
#   enable ONLY against a verified API contract (no endpoint/auth is shipped).
QMETRY_EMIT_MODE=local
# QMETRY_EVENTS_FILE=        # default: <project>/.aidlc/guardrails/qmetry-events.jsonl
# QMETRY_API_URL=           # live only; a verified QMetry360 endpoint
# QMETRY_TOKEN_ENV=         # live only; name of the env var holding the bearer token
