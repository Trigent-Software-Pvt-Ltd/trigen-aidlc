# AI-DLC guardrails — shipped defaults. Do NOT edit here to customise:
# create <project>/.aidlc/guardrails.env with the same keys to override per project.
# (/aidlc-init can generate that file from the guardrails: block in aidlc.config.yaml.)
# modes: block | warn | off
GUARDRAILS_ENABLED=true

# HP-2 Publish gate on tracker writes
PUBLISH_GATE_MODE=block
PUBLISH_GATE_TTL=600          # seconds an approval stays valid (covers a batch transfer)
PUBLISH_GATE_SINGLE_USE=false # true = one approval unlocks one write
PUBLISH_GATE_INCLUDE_BASH=true # also gate glab/acli/jira writes tunnelled through Bash

# HP-3 EARS validation before an AC-catalogue publish
EARS_MODE=warn

# HP-4 Secret scan on write/Bash tool arguments
SECRET_SCAN_MODE=block

# HP-5 Transfer sentinel (leaf completeness) — off by default
SENTINEL_ENABLED=false
SENTINEL_MODE=warn
